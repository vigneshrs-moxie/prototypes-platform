# The site's settings. On Vercel they are set in Settings → Environment Variables; DATABASE_URL and
# BLOB_READ_WRITE_TOKEN come from connecting the stores. For a local trial with real Google, copy
# this file to .env.local and fill it in; never commit a value.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAIN=
ADMIN_EMAILS=
SESSION_SECRET=
SITE_URL=
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# Keeps Vercel's body helpers off, so a multipart publish reaches the site whole.
NODEJS_HELPERS=0
